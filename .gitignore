# Копия llama.cpp: в коммит попадают ТОЛЬКО наши файлы, всё остальное игнорируется
/llama.cpp-hiddenstates/*
!/llama.cpp-hiddenstates/examples/
/llama.cpp-hiddenstates/examples/*
!/llama.cpp-hiddenstates/examples/CMakeLists.txt
!/llama.cpp-hiddenstates/examples/hidden-states/

# Вторая копия llama.cpp (master 785322d17): та же политика — в git только наши файлы
/llama.cpp-hiddenstates-new/*
!/llama.cpp-hiddenstates-new/examples/
/llama.cpp-hiddenstates-new/examples/*
!/llama.cpp-hiddenstates-new/examples/CMakeLists.txt
!/llama.cpp-hiddenstates-new/examples/hidden-states/

# Локальный черновик плана (не коммитим)
/GLOBALPLAN.md

# Python-пайплайн: артефакты окружения; под out/ — только тяжёлые бинарники и логи
/pipeline/.venv/
/pipeline/__pycache__/
/pipeline/out/**/*.npy
/pipeline/out/*.log
/pipeline/out/**/*.log
/pipeline/out/equiv/*/

# Короткие prompt-trials перед валидными пилотами (итоги перенесены в документацию)
/pipeline/out/pilot20_*/
/pipeline/out/pilot20_lfm*.jsonl
/pipeline/out/lfm_trials_*/
/pipeline/out/lfm_prompt_trials.jsonl
/pipeline/out/main_lfm25_final_idempotent.jsonl

.env
.vscode

# Kaggle: собранный датасет/ноутбук и скачанные выходы ядер
/kaggle/**/_build/
/kaggle/**/out/
/kaggle/**/__pycache__/
