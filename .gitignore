# Копия llama.cpp: в коммит попадают ТОЛЬКО наши файлы, всё остальное игнорируется
/llama.cpp-hiddenstates/*
!/llama.cpp-hiddenstates/examples/
/llama.cpp-hiddenstates/examples/*
!/llama.cpp-hiddenstates/examples/CMakeLists.txt
!/llama.cpp-hiddenstates/examples/hidden-states/

# Вторая копия llama.cpp (master 785322d17): та же политика — в git только наши файлы
/llama.cpp-hiddenstates-new/*
!/llama.cpp-hiddenstates-new/examples/
/llama.cpp-hiddenstates-new/examples/*
!/llama.cpp-hiddenstates-new/examples/CMakeLists.txt
!/llama.cpp-hiddenstates-new/examples/hidden-states/

# Локальный черновик плана (не коммитим)
/GLOBALPLAN.md

# Python-пайплайн: артефакты окружения; под out/ — только тяжёлые бинарники и логи
/pipeline/.venv/
/pipeline/__pycache__/
/pipeline/**/__pycache__/
/pipeline/.pytest_cache/
/scripts/__pycache__/
/pipeline/out/**/*.npy
/pipeline/out/*.log
/pipeline/out/**/*.log
/pipeline/out/equiv/*/

# Диагностика раннера: дампы промпта, preflight-отчёты, проверка идемпотентности
/pipeline/out/prompt_*

# Детерминированно пересобираемые prepared inputs (source + builder находятся в git)
/pipeline/data/pilot_gptoss_final.jsonl
/pipeline/data/main_gptoss_final.jsonl

# Короткие prompt-trials перед валидными пилотами (итоги перенесены в документацию)
/pipeline/out/pilot20_*/
/pipeline/out/pilot20_lfm*.jsonl
/pipeline/out/lfm_trials_*/
/pipeline/out/lfm_prompt_trials.jsonl
/pipeline/out/main_lfm25_final_idempotent.jsonl
/pipeline/out/diag_lfm25_thinking_*/
/pipeline/out/lfm25_thinking_*_reasoning/
/pipeline/out/lfm25_thinking_*_reasoning_rest_*/
/pipeline/out/lfm25_thinking_*_finalgen/
/pipeline/out/lfm25_thinking_*_protocol/
/pipeline/out/**/*.log.stdout
/pipeline/out/pilot_lfm25_1p2b_thinking_r32_q4/meta.raw.jsonl
/pipeline/out/main_lfm25_1p2b_thinking_r32_q4/meta.raw.jsonl
/pipeline/out/pilot_lfm25_1p2b_thinking_r32_q4_v2/meta.raw.jsonl
/pipeline/out/main_lfm25_1p2b_thinking_r32_q4_v2/meta.raw.jsonl
/pipeline/data/pilot_lfm25_thinking_r32_final.jsonl

.env
.vscode

# Kaggle: собранный датасет/ноутбук и скачанные выходы ядер
/kaggle/**/_build/
/kaggle/**/out/
/kaggle/**/__pycache__/
